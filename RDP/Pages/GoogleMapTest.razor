@page "/google-maps-test"
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="container-fluid mt-2" style="max-width: 1200px;">
    <h3 class="mb-1">Konum AR-GE</h3>
    <p class="text-muted small mb-3">Harita üzerinde bir noktaya tıklayarak veya adres/yer adı yazarak konum seçebilirsiniz.</p>

    <div class="row mb-2">
        <div class="col-md-5 d-flex">
            <input @bind="SearchText"
                   @bind:event="oninput"
                   @onkeyup="@(e => e.Key == "Enter" ? SearchLocation() : null)"
                   class="form-control form-control-sm me-2"
                   placeholder="Konum ara (istanbul, konya...)" />
            <button class="btn btn-sm btn-outline-danger text-nowrap" @onclick="SearchLocation">Konumu Bul</button>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div id="mapContainer" style="height: 350px; width: 100%; border: 1px solid #ccc; border-radius: 4px;"></div>
        </div>
    </div>

    <div class="card mt-2 shadow-sm border-0 bg-light">
        <div class="card-body p-3">
            <h6 class="card-title mb-3">Seçili Konum</h6>
            <div class="row g-3">
                <div class="col-sm-4">
                    <label class="small text-muted d-block">Enlem (Latitude)</label>
                    <input class="form-control form-control-sm" value="@Lat.ToString().Replace(",", ".")" readonly />
                </div>
                <div class="col-sm-4">
                    <label class="small text-muted d-block">Boylam (Longitude)</label>
                    <input class="form-control form-control-sm" value="@Lng.ToString().Replace(",", ".")" readonly />
                </div>
                <div class="col-sm-4 d-flex align-items-end gap-2">
                    <button class="btn btn-danger btn-sm w-100" @onclick="OpenInGoogleMaps">Google Maps'te Aç</button>
                    <button class="btn btn-outline-secondary btn-sm w-100" @onclick="ClearLocation">Konumu Temizle</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string SearchText { get; set; }
    private double Lat { get; set; } = 41.0082;
    private double Lng { get; set; } = 28.9784;
    private DotNetObjectReference<GoogleMapTest>? objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("initMapPicker", "mapContainer", objRef);
        }
    }

    [JSInvokable] // JavaScript'ten bu metodun çağrılmasını sağlar
    public void UpdateCoordinates(double lat, double lng)
    {
        Lat = lat;
        Lng = lng;
        StateHasChanged(); // Arayüzü güncelle
    }

    private async Task SearchLocation()
    {
        if (!string.IsNullOrWhiteSpace(SearchText))
            await JSRuntime.InvokeVoidAsync("searchLocation", SearchText, objRef);
    }

    private void OpenInGoogleMaps()
    {
        var url = $"https://www.google.com/maps?q={Lat},{Lng}";
        JSRuntime.InvokeVoidAsync("open", url, "_blank");
    }

    private void ClearLocation()
    {
        SearchText = "";
        UpdateCoordinates(41.0082, 28.9784);
        // JS tarafına da konumu resetlemesi için komut gönderilebilir
    }

    public void Dispose() => objRef?.Dispose();
}