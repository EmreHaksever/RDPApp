@page "/"
@page "/login"
@inject NavigationManager NavManager
@inject RDPApp.Services.GuacamoleService GuacService
@inject RDPApp.Services.UserSession UserSession

<div class="d-flex justify-content-center align-items-center vh-100 bg-gradient" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <style>
        .login-card .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }

        .login-card .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            transition: transform 0.2s, box-shadow 0.2s;
        }

            .login-card .btn-primary:hover:not(:disabled) {
                transform: translateY(-2px);
                box-shadow: 0 8px 16px rgba(102, 126, 234, 0.4);
                background: linear-gradient(135deg, #5568d3 0%, #6a3f8f 100%);
            }

            .login-card .btn-primary:active:not(:disabled) {
                transform: translateY(0);
            }
    </style>

    <div class="card shadow-lg border-0 login-card" style="width: 420px; border-radius: 1rem;">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                    <span class="oi oi-monitor text-primary" style="font-size: 2.5rem;"></span>
                </div>
                <h2 class="fw-bold text-dark mb-2">Hoş Geldiniz</h2>
                <p class="text-muted mb-0">Kurumsal RDP Yönetim Sistemi</p>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                    <span class="oi oi-warning me-2"></span>
                    <div>@ErrorMessage</div>
                </div>
            }

            <form @onsubmit="HandleLogin" @onsubmit:preventDefault="true">
                <div class="mb-4">
                    <label class="form-label fw-semibold text-dark">
                        <span class="oi oi-person me-2"></span>Kullanıcı Adı
                    </label>
                    <input class="form-control form-control-lg"
                           @bind="Username"
                           placeholder="Kullanıcı adınızı girin"
                           disabled="@IsLoading"
                           autocomplete="username" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold text-dark">
                        <span class="oi oi-lock-locked me-2"></span>Şifre
                    </label>
                    <input type="password"
                           class="form-control form-control-lg"
                           @bind="Password"
                           placeholder="Şifrenizi girin"
                           disabled="@IsLoading"
                           autocomplete="current-password" />
                </div>

                <button type="submit"
                        class="btn btn-primary btn-lg w-100 fw-semibold"
                        disabled="@IsLoading"
                        style="border-radius: 0.5rem;">
                    @if (IsLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Giriş yapılıyor...</span>
                    }
                    else
                    {
                        <span class="oi oi-account-login me-2"></span>
                        <span>Giriş Yap</span>
                    }
                </button>
            </form>
        </div>
    </div>
</div>

@code {
    private string Username;
    private string Password;
    private string ErrorMessage;
    private bool IsLoading = false;

    private async Task HandleLogin()
    {
        IsLoading = true;
        ErrorMessage = "";

        try
        {
            // 1. Token al
            var token = await GuacService.GetAuthTokenAsync(Username, Password);

            if (string.IsNullOrEmpty(token))
            {
                ErrorMessage = "Kullanıcı adı veya şifre hatalı.";
                IsLoading = false;
                return;
            }

            // 2. Token'ı session'a kaydet
            UserSession.Username = Username;
            UserSession.AuthToken = token;

            // 3. Guacamole'den admin kontrolü yap (dinamik olarak)
            UserSession.IsAdmin = await GuacService.CheckIfAdminAsync(token);

            // 4. RDP sayfasına yönlendir
            NavManager.NavigateTo("/rdp");
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Giriş sırasında hata: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }
}