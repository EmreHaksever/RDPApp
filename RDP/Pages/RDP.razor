@page "/rdp"
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json

<h3>Özgün RDP Bağlantısı (Blazor Kontrollü)</h3>

<div class="card p-3 mb-4 shadow">
    <h4 class="mb-3">Bağlantı Bilgileri</h4>

    <div class="form-group">
        <label for="rdpHost">RDP Host:</label>
        <input id="rdpHost" class="form-control" @bind="ConnectionModel.Host" placeholder="Örn: 192.168.1.10" />
    </div>

    @if (IsAdmin)
    {
        <div class="form-group mt-2">
            <label for="rdpUser">Kullanıcı Adı:</label>
            <input id="rdpUser" class="form-control" @bind="ConnectionModel.Username" placeholder="Kullanıcı Adı" />
        </div>
        <div class="form-group mt-2">
            <label for="rdpPass">Şifre:</label>
            <input id="rdpPass" class="form-control" type="password" @bind="ConnectionModel.Password" placeholder="Şifre" />
        </div>
    }

    <button class="btn btn-primary mt-3" @onclick="ConnectRDP" disabled="@IsConnecting">
        @if (IsConnecting)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
        }
        RDP Oturumunu Başlat
    </button>
</div>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger mt-3">
        <h5 class="alert-heading">Hata Detayı</h5>
        <p>@((MarkupString)ErrorMessage)</p>
    </div>
}

<div id="guacamole-display" style="width: 100%; height: 600px; border: 1px solid #007bff; background-color: #000; position: relative; display: @(ConnectionStarted ? "block" : "none");">
</div>


@code {
    // Controller'dan dönecek olan session bilgisi için YENİ ve DOĞRU sınıf
    private class GuacSessionInfo
    {
        public string? AuthToken { get; set; }
        public string? ConnectionId { get; set; }
    }

    // API'ye gönderilecek model
    public class RDPConnectModel
    {
        public string Host { get; set; } = "";
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }

    public bool IsAdmin { get; set; } = true;
    private RDPConnectModel ConnectionModel { get; set; } = new();

    private bool IsConnecting = false;
    private bool ConnectionStarted = false;
    private string ErrorMessage = "";

    private async Task ConnectRDP()
    {
        IsConnecting = true;
        ConnectionStarted = false; // Her yeni denemede ekranı gizle
        ErrorMessage = "";
        StateHasChanged();

        try
        {
            var response = await Http.PostAsJsonAsync("api/rdp/start-session", ConnectionModel);

            if (!response.IsSuccessStatusCode)
            {
                string errorDetail = await response.Content.ReadAsStringAsync();
                ErrorMessage =
                    $"<strong class='d-block'>Durum Kodu:</strong> {response.StatusCode} ({response.ReasonPhrase})<br/>" +
                    $"<strong class='d-block mt-2'>Guacamole Hata JSON'u:</strong> " +
                    $"<pre class='bg-light text-dark p-2 rounded'>{System.Net.WebUtility.HtmlEncode(errorDetail)}</pre>";
                return;
            }

            // DÜZELTME 1: Doğru modeli (GuacSessionInfo) okuyoruz.
            var sessionInfo = await response.Content.ReadFromJsonAsync<GuacSessionInfo>();

            // DÜZELTME 2: Gelen AuthToken'i kontrol ediyoruz, TunnelKey'i değil!
            if (sessionInfo != null && !string.IsNullOrEmpty(sessionInfo.AuthToken) && !string.IsNullOrEmpty(sessionInfo.ConnectionId))
            {
                ConnectionStarted = true;
                StateHasChanged(); // Div'in görünür olması için UI'ı güncelle

                // DÜZELTME 3: JavaScript'e AuthToken ve ConnectionId'yi gönderiyoruz.
                await JSRuntime.InvokeVoidAsync("GuacInterop.startClient",
                    sessionInfo.AuthToken,
                    sessionInfo.ConnectionId,
                    "guacamole-display");
            }
            else
            {
                ErrorMessage = "Sunucudan geçerli oturum bilgileri (AuthToken/ConnectionId) alınamadı.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Beklenmedik Hata: {ex.Message}";
        }
        finally
        {
            IsConnecting = false;
        }
    }
}