@page "/rdp"
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json

<h3>RDP Bağlantısı</h3>

<div class="card p-3 mb-4 shadow">
    <h4 class="mb-3">Bağlantı Bilgileri</h4>

    <div class="form-group">
        <label>RDP Host:</label>
        <input class="form-control" @bind="Host" placeholder="192.168.1.100" />
    </div>

    <div class="form-group mt-2">
        <label>Kullanıcı Adı:</label>
        <input class="form-control" @bind="Username" placeholder="Administrator" />
    </div>

    <div class="form-group mt-2">
        <label>Şifre:</label>
        <input class="form-control" type="password" @bind="Password" />
    </div>

    <button class="btn btn-primary mt-3" @onclick="ConnectRDP" disabled="@IsConnecting">
        @if (IsConnecting)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
        }
        RDP Oturumunu Başlat
    </button>

    @if (ConnectionStarted)
    {
        <button class="btn btn-danger mt-3 ms-2" @onclick="DisconnectRDP">
            Bağlantıyı Kes
        </button>
    }
</div>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger mt-3">
        <h5>⚠️ Hata</h5>
        <p>@ErrorMessage</p>
    </div>
}

@if (!string.IsNullOrEmpty(DebugInfo))
{
    <div class="alert alert-info mt-3">
        <h6>🔍 Debug</h6>
        <pre>@DebugInfo</pre>
    </div>
}

@if (ConnectionStarted)
{
    <div class="card mt-4 shadow">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">🖥️ Uzaktan Masaüstü</h5>
        </div>
        <div class="card-body p-0" style="background: #000;">
            <div id="guacamole-display"
                 style="width: 100%;
                            height: 700px;
                            background: #1a1a1a;
                            position: relative;
                            overflow: hidden;
                            display: flex;
                            align-items: center;
                            justify-content: center;">
                <div class="text-white text-center p-5">
                    <div class="spinner-border text-light mb-3"></div>
                    <p>RDP yükleniyor...</p>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string Host { get; set; } = "192.168.1.1";
    private string Username { get; set; } = "User";
    private string Password { get; set; } = "Pass123";

    private bool IsConnecting = false;
    private bool ConnectionStarted = false;
    private string ErrorMessage = "";
    private string DebugInfo = "";

    private async Task ConnectRDP()
    {
        IsConnecting = true;
        ErrorMessage = "";
        DebugInfo = "";

        try
        {
            // 1. Backend'e RDP bilgilerini gönder
            var model = new { Host, Username, Password };

            DebugInfo = $"📡 İstek: POST /api/rdp/start-session\nHost: {Host}";

            var response = await Http.PostAsJsonAsync("/api/rdp/start-session", model);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                ErrorMessage = $"Backend hatası: {response.StatusCode}\n{error}";
                return;
            }

            // 2. Token ve Connection ID al
            var sessionInfo = await response.Content.ReadFromJsonAsync<GuacSessionInfo>();

            if (sessionInfo == null || string.IsNullOrEmpty(sessionInfo.AuthToken))
            {
                ErrorMessage = "Sunucudan geçersiz yanıt alındı";
                return;
            }

            DebugInfo = $"✅ Token: {sessionInfo.AuthToken[..20]}...\n" +
                       $"✅ Connection ID: {sessionInfo.ConnectionId}";

            // 3. UI'yi güncelle ve DOM render bekle
            ConnectionStarted = true;
            StateHasChanged();
            await Task.Delay(100); // DOM'un render olmasını bekle

            // 4. ✅ JavaScript'e token ve connection ID gönder
            // JavaScript tarafında tunnel ID REST API ile alınacak
            await JSRuntime.InvokeVoidAsync(
                "GuacInterop.startClient",
                sessionInfo.AuthToken,        // 1. parametre: authToken
                sessionInfo.ConnectionId,     // 2. parametre: connectionId
                "guacamole-display"          // 3. parametre: displayElementId
            );

            Console.WriteLine("✅ Guacamole başlatıldı");

            DebugInfo += $"\n\n✅ JavaScript'e gönderildi:\n" +
                        $"• Token: {sessionInfo.AuthToken[..20]}...\n" +
                        $"• Connection ID: {sessionInfo.ConnectionId}\n" +
                        $"• Display Element: guacamole-display\n" +
                        $"• Tunnel ID JavaScript tarafında alınacak";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Hata: {ex.Message}\n{ex.StackTrace}";
            Console.WriteLine($"❌ ConnectRDP Error: {ex}");
        }
        finally
        {
            IsConnecting = false;
        }
    }

    private async Task DisconnectRDP()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("GuacInterop.disconnect");
            ConnectionStarted = false;
            DebugInfo = "";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Disconnect error: {ex.Message}");
        }
    }

    // Model
    public record GuacSessionInfo(string AuthToken, string ConnectionId);
}