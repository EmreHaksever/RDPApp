@page "/rdp"
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@using System.Net.Http.Json

<h3>RDP Bağlantı Yönetimi</h3>

<div class="card p-3 mb-4 shadow">
    <h4 class="mb-3">Yeni Bağlantı Oluştur</h4>

    <div class="form-group">
        <label>RDP Host:</label>
        <input class="form-control" @bind="Host" placeholder="192.168.1.1" />
    </div>

    <div class="form-group mt-2">
        <label>Kullanıcı Adı:</label>
        <input class="form-control" @bind="Username" placeholder="User" />
    </div>

    <div class="form-group mt-2">
        <label>Şifre:</label>
        <input class="form-control" type="password" @bind="Password" />
    </div>

    <button class="btn btn-primary mt-3" @onclick="CreateGuacConnection" disabled="@IsConnecting">
        @if (IsConnecting)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
        }
        Bağlantı Oluştur
    </button>
</div>

@if (AvailableConnections.Count > 0)
{
    <div class="card p-3 mb-4 shadow">
        <h4 class="mb-3">Mevcut Bağlantılar</h4>

        <ul class="list-group">
            @foreach (var connection in AvailableConnections)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center
                                    @(connection == ActiveSession ? "active" : "")">

                    <div>
                        <span class="fw-bold">@connection.DisplayName</span>
                        @if (connection == ActiveSession)
                        {
                            <span class="badge bg-success ms-2">AKTİF</span>
                        }
                    </div>

                    @if (connection != ActiveSession)
                    {
                        <button class="btn btn-sm btn-success" @onclick="() => StartRDP(connection)">
                            RDP Başlat
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-danger" @onclick="DisconnectRDP">
                            Bağlantıyı Kes
                        </button>
                    }
                </li>
            }
        </ul>
    </div>
}

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger mt-3">
        <h5>⚠️ Hata</h5>
        <p>@ErrorMessage</p>
    </div>
}

@if (!string.IsNullOrEmpty(DebugInfo))
{
    <div class="alert alert-info mt-3">
        <h6>🔍 Debug</h6>
        <pre>@DebugInfo</pre>
    </div>
}

@if (ActiveSession != null)
{
    <div class="card mt-4 shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between
                 align-items-center">
            <h5 class="mb-0">🖥️ Uzaktan Masaüstü</h5>
            <small class="text-white-50">Connection ID: @ActiveSession.ConnectionId</small>
        </div>
        <div class="card-body p-0" style="background: #000;">
            <div id="guacamole-display"
                 style="width: 100%;
                            height: 700px;
                            background: #000;
                            position: relative;
                            overflow: hidden;">
            </div>
        </div>
    </div>
}

@code {
    // Session bilgisini tutan model (mevcut)
    public record GuacSessionInfo(string AuthToken, string ConnectionId);

    // Yeni model: Frontend'de tutulacak bağlantı bilgileri
    // Yeni model: Frontend'de tutulacak bağlantı bilgileri
    public record StoredConnection(string Host, string Username, string AuthToken, string ConnectionId)
    {
        // Bağlantı ID'sinin ilk 4 karakterini (güvenli bir şekilde) gösteren yardımcı özellik
        public string DisplayName
        {
            get
            {
                // Bağlantı ID'si null veya boşsa, ID'yi gösterme
                if (string.IsNullOrEmpty(ConnectionId))
                {
                    return $"{Username}@{Host} (ID: N/A)";
                }

                // ID'nin ilk 4 karakterini al, ID 4 karakterden kısaysa tümünü al.
                var shortId = ConnectionId.Length >= 4 ? ConnectionId.Substring(0, 4) : ConnectionId;

                return $"{Username}";
            }
        }
    }
    // Connection ID'nin ilk 4 karakterini gösteren yardımcı özellik
        

    // Aktif RDP oturumu bilgisi (Başlatılmış ve ekranda görünen)
    private StoredConnection? ActiveSession = null;

    // Oluşturulmuş ama henüz başlatılmamış bağlantıların listesi
    private List<StoredConnection> AvailableConnections = new();

    private string Host { get; set; } = "192.168.1.1";
    private string Username { get; set; } = "User";
    private string Password { get; set; } = "Pass123";

    private bool IsConnecting = false;
    private string ErrorMessage = "";
    private string DebugInfo = "";

    // Bağlantı Oluştur (eski ConnectRDP)
    private async Task CreateGuacConnection()
    {
        IsConnecting = true;
        ErrorMessage = "";
        DebugInfo = "";

        // Bağlantı oluşturulmadan önce aktif oturumu kapat
        if (ActiveSession != null)
        {
            await DisconnectRDP();
        }

        try
        {
            // 1. Backend'e RDP bilgilerini gönder
            var model = new { Host, Username, Password };

            DebugInfo = $"📡 İstek: POST /api/rdp/start-session\nHost: {Host}";

            var response = await Http.PostAsJsonAsync("/api/rdp/start-session", model);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                ErrorMessage = $"Backend hatası: {response.StatusCode}\n{error}";
                return;
            }

            // 2. Token ve Connection ID al
            var newSessionInfo = await response.Content.ReadFromJsonAsync<GuacSessionInfo>();
            if (newSessionInfo == null || string.IsNullOrEmpty(newSessionInfo.AuthToken))
            {
                ErrorMessage = "Sunucudan geçersiz yanıt alındı";
                return;
            }

            // 3. Bağlantıyı listeye ekle
            var newConnection = new StoredConnection(Host, Username, newSessionInfo.AuthToken, newSessionInfo.ConnectionId);
            AvailableConnections.Add(newConnection);

            DebugInfo = $"✅ Yeni Bağlantı Oluşturuldu:\n" +
                        $"• Host: {newConnection.Host}\n" +
                        $"• Connection ID: {newConnection.ConnectionId}\n" +
                        $"• Artık 'Mevcut Bağlantılar' listesinden başlatılabilir.";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Hata: {ex.Message}\n{ex.StackTrace}";
            Console.WriteLine($"❌ CreateGuacConnection Error: {ex}");
        }
        finally
        {
            IsConnecting = false;
        }
    }

    // RDP Oturumunu Başlat
    private async Task StartRDP(StoredConnection connection)
    {
        // Eğer zaten aktif bir oturum varsa, önce onu kapat
        if (ActiveSession != null && ActiveSession != connection)
        {
            await DisconnectRDP();
        }

        ActiveSession = connection;

        DebugInfo = $"✅ Token: {connection.AuthToken[..20]}...\n" +
                    $"✅ Connection ID: {connection.ConnectionId}";

        // UI'yi güncelle ve DOM render bekle
        StateHasChanged();
        await Task.Delay(100); // DOM'un render olmasını bekle

        // JavaScript'e token ve connection ID gönder
        await JSRuntime.InvokeVoidAsync(
            "GuacInterop.startClient",
            connection.AuthToken,
            connection.ConnectionId,
            "guacamole-display"
        );
        Console.WriteLine("✅ Guacamole başlatıldı");

        DebugInfo += $"\n\n✅ JavaScript'e gönderildi:\n" +
                    $"• Token: {connection.AuthToken[..20]}...\n" +
                    $"• Connection ID: {connection.ConnectionId}\n" +
                    $"• Display Element: guacamole-display\n" +
                    $"• Tunnel ID JavaScript tarafında alınacak";
    }

    // Mevcut RDP oturumunu kes
    private async Task DisconnectRDP()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("GuacInterop.disconnect");
            ActiveSession = null;
            DebugInfo = "";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Disconnect error: {ex.Message}");
        }
    }
}