@page "/rdp"
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@inject RDPApp.Services.GuacamoleService GuacService
@inject RDPApp.Services.UserSession UserSession

<div class="container-fluid h-100 d-flex flex-column">

    <div class="row bg-primary text-white p-2 align-items-center shadow-sm" style="flex: 0 0 auto;">
        <div class="col">
            <h5 class="m-0">RDP Yönetim Paneli</h5>
        </div>
        <div class="col-auto d-flex align-items-center">
            <span class="me-3">
                <span class="oi oi-person me-1"></span> @UserSession.Username
                @(UserSession.IsAdmin ? "(Yönetici)" : "(Kullanıcı)")
            </span>
            <button class="btn btn-sm btn-light text-primary" @onclick="Logout">Çıkış Yap</button>
        </div>
    </div>

    <div class="row flex-grow-1" style="overflow: hidden;">

        <div class="col-md-3 bg-light border-end d-flex flex-column p-0" style="overflow-y: auto;">

            @if (UserSession.IsAdmin)
            {
                <div class="p-3 border-bottom bg-white">
                    <h6 class="text-primary mb-3"><span class="oi oi-plus me-1"></span>Yeni Bağlantı Oluştur</h6>

                    <div class="mb-2">
                        <label class="form-label small text-muted mb-0">Bağlantı Adı</label>
                        <input class="form-control form-control-sm" @bind="NewConnectionName" placeholder="Örn: Muhasebe PC" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-0">IP Adresi</label>
                        <input class="form-control form-control-sm" @bind="NewHost" placeholder="192.168.1.X" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-0">Kullanıcı Adı</label>
                        <input class="form-control form-control-sm" @bind="NewUser" placeholder="PC Kullanıcı Adı" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-0">Şifre</label>
                        <input type="password" class="form-control form-control-sm" @bind="NewPass" placeholder="PC Şifresi" />
                    </div>

                    <button class="btn btn-sm btn-outline-primary w-100 mt-2" @onclick="CreateConnection" disabled="@IsCreating">
                        @(IsCreating ? "Oluşturuluyor..." : "Bağlantı Oluştur")
                    </button>

                    @if (!string.IsNullOrEmpty(CreateMessage))
                    {
                        <div class="alert alert-info mt-2 p-1 small">@CreateMessage</div>
                    }
                </div>
            }

            <div class="p-3 flex-grow-1">
                <h6 class="text-secondary mb-3"><span class="oi oi-list me-1"></span>Erişilebilir Bilgisayarlar</h6>

                @if (AvailableConnections == null)
                {
                    <p class="text-muted small">Yükleniyor...</p>
                }
                else if (AvailableConnections.Count == 0)
                {
                    <div class="alert alert-warning small">Listenizde bilgisayar yok.</div>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var conn in AvailableConnections)
                        {
                            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-0 @(ActiveConnectionId == conn.Identifier ? "border-primary" : "")">

                                <button type="button" class="btn btn-link text-decoration-none text-dark text-start flex-grow-1 p-3"
                                        @onclick="() => ConnectToSession(conn)">
                                    <span class="fw-bold">@conn.Name</span>
                                    @if (ActiveConnectionId == conn.Identifier)
                                    {
                                        <span class="badge bg-primary ms-2">Aktif</span>
                                    }
                                </button>

                                @if (UserSession.IsAdmin)
                                {
                                    <button class="btn btn-link text-danger p-3" @onclick="() => DeleteConnection(conn)" title="Bu bağlantıyı sil">
                                        <span class="oi oi-trash"></span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-md-9 p-0 bg-dark position-relative d-flex flex-column">

            @if (!string.IsNullOrEmpty(ActiveConnectionId))
            {
                <div class="bg-secondary text-white p-2 d-flex justify-content-between align-items-center" style="flex: 0 0 auto; z-index: 100;">
                    <span class="small ms-2"><span class="oi oi-monitor me-1"></span>Aktif Oturum</span>

                    <div>
                        <button class="btn btn-sm btn-light me-2" @onclick="TriggerFullScreen" title="Tekrar Tam Ekran Yap">
                            <span class="oi oi-fullscreen-enter me-1"></span> Tam Ekran
                        </button>

                        <button class="btn btn-sm btn-danger me-2" @onclick="DisconnectSession">
                            <span class="oi oi-power-standby me-1"></span> Bağlantıyı Kes
                        </button>
                    </div>
                </div>
            }

            <div style="flex-grow: 1; position: relative; overflow: hidden;">
                @if (string.IsNullOrEmpty(ActiveConnectionId))
                {
                    <div class="d-flex justify-content-center align-items-center h-100 text-white-50">
                        <div class="text-center">
                            <h1 class="display-1"><span class="oi oi-monitor"></span></h1>
                            <p>Bağlanmak için soldan bir bilgisayar seçin.</p>
                        </div>
                    </div>
                }

                <div id="guacamole-display" style="width: 100%; height: 100%;"></div>
            </div>
        </div>
    </div>
</div>

@code {
    // Modeller
    public class ConnectionItem { public string Identifier { get; set; } public string Name { get; set; } }

    // Değişkenler
    private List<RDPApp.Services.GuacConnectionDetail> AvailableConnections;
    private string ActiveConnectionId;

    // Admin Değişkenleri
    private string NewConnectionName, NewHost, NewUser, NewPass, CreateMessage;
    private bool IsCreating = false;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            NavManager.NavigateTo("/login");
            return;
        }

        await LoadConnections();
    }

    private async Task LoadConnections()
    {
        AvailableConnections = await GuacService.GetConnectionsAsync(UserSession.AuthToken);
    }

    // Admin: Yeni Bağlantı Oluşturma
    private async Task CreateConnection()
    {
        if (string.IsNullOrWhiteSpace(NewHost) || string.IsNullOrWhiteSpace(NewConnectionName))
        {
            CreateMessage = "Lütfen bağlantı adı ve IP adresini giriniz.";
            return;
        }

        IsCreating = true;
        CreateMessage = "";

        var newId = await GuacService.CreateConnectionAsync(UserSession.AuthToken, NewConnectionName, NewHost, NewUser, NewPass);

        if (!string.IsNullOrEmpty(newId))
        {
            CreateMessage = "Bağlantı başarıyla eklendi!";
            NewConnectionName = NewHost = NewUser = NewPass = "";
            await LoadConnections();
        }
        else
        {
            CreateMessage = "Hata oluştu. Guacamole loglarını kontrol edin.";
        }
        IsCreating = false;
    }

    // Admin: Bağlantı Silme
    private async Task DeleteConnection(RDPApp.Services.GuacConnectionDetail conn)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"'{conn.Name}' bağlantısını silmek istediğinize emin misiniz?");

        if (confirmed)
        {
            if (ActiveConnectionId == conn.Identifier)
            {
                await DisconnectSession();
            }

            bool success = await GuacService.DeleteConnectionAsync(UserSession.AuthToken, conn.Identifier);
            if (success)
            {
                await LoadConnections();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Silme işlemi başarısız oldu.");
            }
        }
    }

    // Bağlantı Başlatma
    private async Task ConnectToSession(RDPApp.Services.GuacConnectionDetail conn)
    {
        if (ActiveConnectionId == conn.Identifier) return;

        await DisconnectSession();

        ActiveConnectionId = conn.Identifier;

        await JSRuntime.InvokeVoidAsync(
            "GuacInterop.startClient",
            UserSession.AuthToken,
            conn.Identifier,
            "guacamole-display"
        );
    }

    // GÜNCELLEME: Tam Ekran Tetikleyici Metodu Eklendi
    private async Task TriggerFullScreen()
    {
        await JSRuntime.InvokeVoidAsync("GuacInterop.enterFullScreen");
    }

    // Bağlantıyı Kesme
    private async Task DisconnectSession()
    {
        if (!string.IsNullOrEmpty(ActiveConnectionId))
        {
            await JSRuntime.InvokeVoidAsync("GuacInterop.disconnect");
            ActiveConnectionId = null;
        }
    }

    private void Logout()
    {
        UserSession.AuthToken = null;
        UserSession.Username = null;
        NavManager.NavigateTo("/login");
    }
}