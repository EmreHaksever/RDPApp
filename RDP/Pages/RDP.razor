@page "/rdp"
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@inject RDPApp.Services.GuacamoleService GuacService
@inject RDPApp.Services.UserSession UserSession

<div class="d-flex flex-column vh-100">
    <div class="row bg-primary text-white p-3 align-items-center shadow m-0" style="flex: 0 0 auto;">
        <div class="col">
            <h4 class="m-0 fw-bold"><span class="oi oi-monitor me-2"></span>RDP Yönetim Paneli</h4>
        </div>
        <div class="col-auto d-flex align-items-center">
            <div class="bg-white bg-opacity-25 rounded px-3 py-2 me-2">
                <span class="oi oi-person me-2"></span>
                <strong>@UserSession.Username</strong>
                <span class="badge bg-light text-primary ms-2">@(UserSession.IsAdmin ? "Yönetici" : "Kullanıcı")</span>
            </div>
            <button class="btn btn-light" @onclick="Logout">
                <span class="oi oi-account-logout me-1"></span> Çıkış
            </button>
        </div>
    </div>

    <div class="row flex-grow-1 m-0" style="overflow: hidden; min-height: 0;">

        <div class="col-md-3 bg-light border-end d-flex flex-column p-0" style="overflow-y: auto; max-height: 100%;">

            @if (UserSession.IsAdmin)
            {
                <div class="p-4 border-bottom bg-white shadow-sm">
                    <h6 class="text-primary mb-3 fw-bold">
                        <span class="oi oi-plus me-2"></span>Yeni Bağlantı
                    </h6>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Bağlantı Adı</label>
                        <input class="form-control" @bind="NewConnectionName" placeholder="Örn: Muhasebe PC" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">IP Adresi</label>
                        <input class="form-control" @bind="NewHost" placeholder="192.168.1.X" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Kullanıcı Adı</label>
                        <input class="form-control" @bind="NewUser" placeholder="PC Kullanıcı Adı" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Şifre</label>
                        <input type="password" class="form-control" @bind="NewPass" placeholder="PC Şifresi" />
                    </div>

                    <button class="btn btn-primary w-100" @onclick="CreateConnection" disabled="@IsCreating">
                        @if (IsCreating)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Oluşturuluyor...</span>
                        }
                        else
                        {
                            <span class="oi oi-check me-2"></span>
                            <span>Bağlantı Oluştur</span>
                        }
                    </button>

                    @if (!string.IsNullOrEmpty(CreateMessage))
                    {
                        <div class="alert @(CreateMessage.Contains("başarıyla") ? "alert-success" : "alert-danger") mt-3 mb-0 py-2">
                            <span class="oi oi-@(CreateMessage.Contains("başarıyla") ? "check" : "warning") me-2"></span>@CreateMessage
                        </div>
                    }
                </div>
            }

            <div class="p-4 flex-grow-1">
                <h6 class="text-secondary mb-3 fw-bold">
                    <span class="oi oi-list me-2"></span>Bilgisayarlar
                </h6>

                @if (AvailableConnections == null)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary mb-2" role="status">
                            <span class="visually-hidden">Yükleniyor...</span>
                        </div>
                        <p class="text-muted small mb-0">Yükleniyor...</p>
                    </div>
                }
                else if (AvailableConnections.Count == 0)
                {
                    <div class="text-center py-5">
                        <span class="oi oi-info text-muted" style="font-size: 2rem;"></span>
                        <p class="text-muted mt-3 mb-0">Henüz bilgisayar eklenmemiş.</p>
                    </div>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var conn in AvailableConnections)
                        {
                            <div class="list-group-item list-group-item-action border rounded mb-2 p-0 @(ActiveConnectionId == conn.Identifier ? "border-primary border-2 bg-primary bg-opacity-10" : "")">
                                <div class="d-flex align-items-center">
                                    <button type="button"
                                            class="btn btn-link text-decoration-none text-dark text-start flex-grow-1 p-3 d-flex align-items-center"
                                            @onclick="() => ConnectToSession(conn)">
                                        <span class="oi oi-laptop me-3 text-primary"></span>
                                        <div>
                                            <div class="fw-bold">@conn.Name</div>
                                            @if (ActiveConnectionId == conn.Identifier)
                                            {
                                                <small class="text-success">
                                                    <span class="oi oi-media-record me-1"></span>Bağlı
                                                </small>
                                            }
                                        </div>
                                    </button>

                                    @if (UserSession.IsAdmin)
                                    {
                                        <button class="btn btn-link text-danger p-3"
                                                @onclick="() => DeleteConnection(conn)"
                                                title="Sil">
                                            <span class="oi oi-trash"></span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-md-9 p-0 bg-dark position-relative d-flex flex-column" style="min-height: 0; overflow: hidden;">

            @if (!string.IsNullOrEmpty(ActiveConnectionId))
            {
                <div class="bg-dark bg-gradient text-white p-3 d-flex justify-content-between align-items-center border-bottom border-secondary"
                     style="flex: 0 0 auto; z-index: 100;">
                    <div class="d-flex align-items-center">
                        <span class="badge bg-success me-2">
                            <span class="oi oi-media-record"></span>
                        </span>
                        <span class="fw-semibold">Aktif Oturum</span>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-light" @onclick="TriggerFullScreen">
                            <span class="oi oi-fullscreen-enter me-1"></span> Tam Ekran
                        </button>

                        <button class="btn btn-sm btn-danger" @onclick="DisconnectSession">
                            <span class="oi oi-power-standby me-1"></span> Bağlantıyı Kes
                        </button>
                    </div>
                </div>
            }

            <div style="flex-grow: 1; position: relative; overflow: hidden; min-height: 0;">
                @if (string.IsNullOrEmpty(ActiveConnectionId))
                {
                    <div class="d-flex justify-content-center align-items-center text-white-50" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 10;">
                        <div class="text-center">
                            <div class="mb-4">
                                <span class="oi oi-monitor" style="font-size: 5rem; opacity: 0.3;"></span>
                            </div>
                            <h5 class="mb-3">Bağlantı Bekleniyor</h5>
                            <p class="text-white-50">Bağlanmak için soldan bir bilgisayar seçin</p>
                        </div>
                    </div>
                }

                <div id="guacamole-display" style="width: 100%; height: 100%; position: absolute; top: 0; left: 0;"></div>
            </div>
        </div>
    </div>
</div>

@code {
    // Değişkenler
    private List<RDPApp.Services.GuacConnectionDetail> AvailableConnections;
    private string ActiveConnectionId;

    // Admin Değişkenleri
    private string NewConnectionName, NewHost, NewUser, NewPass, CreateMessage;
    private bool IsCreating = false;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            NavManager.NavigateTo("/login");
            return;
        }

        await LoadConnections();
    }

    private async Task LoadConnections()
    {
        AvailableConnections = await GuacService.GetConnectionsAsync(UserSession.AuthToken);
    }

    // Admin: Yeni Bağlantı Oluşturma
    private async Task CreateConnection()
    {
        if (string.IsNullOrWhiteSpace(NewHost) || string.IsNullOrWhiteSpace(NewConnectionName))
        {
            CreateMessage = "Lütfen bağlantı adı ve IP adresini giriniz.";
            StateHasChanged();
            return;
        }

        IsCreating = true;
        CreateMessage = "";
        StateHasChanged();

        var newId = await GuacService.CreateConnectionAsync(UserSession.AuthToken, NewConnectionName, NewHost, NewUser, NewPass);

        if (!string.IsNullOrEmpty(newId))
        {
            CreateMessage = "Bağlantı başarıyla eklendi!";
            NewConnectionName = NewHost = NewUser = NewPass = "";
            await LoadConnections();
        }
        else
        {
            CreateMessage = "Hata oluştu. Guacamole loglarını kontrol edin.";
        }

        IsCreating = false;
        StateHasChanged();
    }

    // Admin: Bağlantı Silme
    private async Task DeleteConnection(RDPApp.Services.GuacConnectionDetail conn)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"'{conn.Name}' bağlantısını silmek istediğinize emin misiniz?");

        if (confirmed)
        {
            if (ActiveConnectionId == conn.Identifier)
            {
                await DisconnectSession();
            }

            bool success = await GuacService.DeleteConnectionAsync(UserSession.AuthToken, conn.Identifier);
            if (success)
            {
                await LoadConnections();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Silme işlemi başarısız oldu.");
            }
        }
    }

    // Bağlantı Başlatma
    private async Task ConnectToSession(RDPApp.Services.GuacConnectionDetail conn)
    {
        if (ActiveConnectionId == conn.Identifier) return;

        await DisconnectSession();

        ActiveConnectionId = conn.Identifier;

        await JSRuntime.InvokeVoidAsync(
            "GuacInterop.startClient",
            UserSession.AuthToken,
            conn.Identifier,
            "guacamole-display"
        );
    }

    // Tam Ekran Tetikleyici
    private async Task TriggerFullScreen()
    {
        await JSRuntime.InvokeVoidAsync("GuacInterop.enterFullScreen");
    }

    // Bağlantıyı Kesme
    private async Task DisconnectSession()
    {
        if (!string.IsNullOrEmpty(ActiveConnectionId))
        {
            await JSRuntime.InvokeVoidAsync("GuacInterop.disconnect");
            ActiveConnectionId = null;
        }
    }

    private void Logout()
    {
        UserSession.AuthToken = null;
        UserSession.Username = null;
        UserSession.IsAdmin = false;
        NavManager.NavigateTo("/login");
    }
}